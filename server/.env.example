# Copy to .env and fill in locally. NEVER commit real values.
PORT=4000
# FalkorDB connection URL. Accepts redis://, falkor:// (FalkorDB Cloud
# dashboard format) and rediss:// (TLS). A failed connection is NON-fatal:
# the scanner warns and falls back to the in-memory store.
FALKORDB_URL=redis://localhost:6379

# LLM provider (wired during the event; never commit real keys)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
